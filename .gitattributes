# Shell scripts and hook scripts must stay LF, even on Windows clones,
# or Claude Code's bash hook runner breaks on CR.
*.sh text eol=lf
*.bash text eol=lf

# Normalize other text files
*.md text
*.json text

# Test fixtures are compared byte-for-byte; keep them LF everywhere.
# Belt-and-braces only — wiki-lint strips CR and must pass on CRLF input regardless.
plugins/memory-wiki/test/fixtures/** text eol=lf
plugins/memory-wiki/test/expected/** text eol=lf
